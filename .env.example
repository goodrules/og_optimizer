# Google Cloud Configuration for Vertex AI
# Required for Gemini via Vertex AI
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_REGION_GEMINI=global

# Note: Authentication is handled via Application Default Credentials (ADC)
# Run: gcloud auth application-default login
# Or set GOOGLE_APPLICATION_CREDENTIALS to your service account key path